# ---------------------------------------------------------------------------
# Residential Property Acquisition CRM - Jacksonville / Duval County, FL
#
# Every variable here is optional. With none of them set the application still
# runs: it reads the bundled sample extract of real Duval parcels, labels itself
# SAMPLE everywhere, and tells you plainly that no CRM store is attached. That
# is the state a fresh `git clone && pnpm install && pnpm dev` lands in, and it
# is deliberate - nothing about the map, the criteria, the scoring or the search
# needs a credential.
#
# Copy to .env.local for development. On Vercel, set them in
# Project Settings -> Environment Variables and redeploy.
# ---------------------------------------------------------------------------


# --- Property data ---------------------------------------------------------
#
# The output of the continuous Duval County Oracle pipeline. This is the one
# variable that turns the bundled 75,988 parcel sample into the full published
# 404,023 parcel county table, with no code change: everything property shaped
# goes through lib/data/source.ts, and the DuckDB implementation reads whatever
# parquet this points at over HTTP range requests.
#
# The pipeline publishes to IPFS and re-points a mutable IPNS name at each new
# root, so this URL keeps working as the data refreshes.
#
# Published by: https://github.com/prismteam-ai/oracle-property-intelligence-platform-pipeline-duval-fl
#
# PROPERTY_DATA_URL=https://ipfs.filebase.io/ipns/k51qzi5uqu5djeq93ll0n7gsrzwfry2jmxb3xa66tcthufpjxv0c3odj1hpq4r

# run-history.json from the same pipeline: one entry per run with per source
# inserted / updated / unchanged counts and the limitations that run declared.
# Alerts cite a run id from here, which is what makes "show the pipeline run
# that triggered this alert" answerable rather than decorative.
#
# RUN_HISTORY_URL=https://ipfs.filebase.io/ipfs/bafybeif2bwakcxmc3p2rkczkqvuecin6657oihsdm5mba5lktajoazemdm

# County identity, used for labels only.
# NEXT_PUBLIC_COUNTY_NAME=Duval
# NEXT_PUBLIC_STATE_CODE=FL

# Where the map opens. Downtown Jacksonville by default.
# NEXT_PUBLIC_MAP_LAT=30.3322
# NEXT_PUBLIC_MAP_LNG=-81.6557
# NEXT_PUBLIC_MAP_ZOOM=10.5


# --- CRM store -------------------------------------------------------------
#
# Postgres. Holds only what a team creates - saved searches, alerts,
# opportunities, outreach, tasks, court records - which is thousands of rows.
# The 404,023 parcels are NOT copied here; they stay in the parquet and are read
# with DuckDB. That is what keeps "no ongoing hosted-database cost beyond the
# existing pipeline + DuckDB / IPFS pattern" true rather than aspirational.
#
# Neon's free tier works and needs no card. Any Postgres does.
# After setting this, run: pnpm db:migrate
#
# Leaving it unset is supported: search, the map, the criteria panel and the
# agent all work, and the CRM surfaces say plainly that no store is attached
# instead of throwing a 500.
#
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require


# --- Scheduled matcher -----------------------------------------------------
#
# The matcher endpoint is called by a scheduler, not a browser, so it is guarded
# by a shared secret rather than a session. With this unset the endpoint is open,
# which is correct for a public demo and is stated here rather than left as a
# surprise.
#
# Set the same value as the MATCHER_TOKEN secret on the GitHub repository that
# runs .github/workflows/matcher.yml, and set RUNTIME_URL there as a repository
# variable pointing at this deployment.
#
# MATCHER_TOKEN=

# Where mocked alert notifications are addressed. Both default to reserved,
# unroutable values (RFC 2606 .invalid, and a 555 number) because nothing here
# should ever reach a real inbox or handset.
# ALERT_EMAIL=acquisitions@example.invalid
# ALERT_SMS=+1-904-555-0100


# --- Mocked outreach -------------------------------------------------------
#
# Whose name and callback number appear in the simulated owner letters.
# OUTREACH_SENDER_NAME=Dana Whitfield, Riverbend Acquisitions
# OUTREACH_SENDER_PHONE=(904) 555-0142


# --- Model provider --------------------------------------------------------
#
# THIS DEPLOYMENT SETS NONE OF THESE, ON PURPOSE. /api/agent is public and
# unauthenticated, so a server side key attached to it is a bill any stranger
# can run up. Visitors bring their own key on /settings; it is held in their
# browser and travels per request in the x-llm-api-key header. With no key
# anywhere the agent returns 501 with a typed body saying so, and every other
# page in the application works exactly as before.
#
# Setting exactly one key below turns a server side default back on with no code
# change. lib/oracle/agent/providers.ts is the source of truth for which
# providers and models are supported; the settings UI and the server both read
# it, so they cannot disagree.

# Optional. One of: google, groq, cerebras, huggingface, vercel-ai-gateway,
# anthropic, bedrock. Naming a provider without giving it a key is treated as a
# misconfiguration rather than quietly falling through to another provider.
# AGENT_PROVIDER=google
# AGENT_MODEL=gemini-3.7-flash

# GOOGLE_GENERATIVE_AI_API_KEY=      # https://aistudio.google.com/apikey
# GROQ_API_KEY=                      # https://console.groq.com/keys
# CEREBRAS_API_KEY=                  # https://cloud.cerebras.ai
# HF_TOKEN=                          # https://huggingface.co/settings/tokens
# AI_GATEWAY_API_KEY=                # Vercel dashboard -> AI Gateway
# ANTHROPIC_API_KEY=                 # https://console.anthropic.com/settings/keys
# AWS_BEARER_TOKEN_BEDROCK=


# --- Abuse controls --------------------------------------------------------
#
# Per client address, counted in process. Several instances may run, so the real
# cap is per instance rather than global.
# AGENT_RATE_LIMIT=15
# AGENT_RATE_WINDOW_MS=600000


# --- Logging ---------------------------------------------------------------
#
# One JSON line per event on stdout. Set to "off" to silence.
# Log lines never contain key material: every message on the agent path goes
# through redaction first, and a key is only ever logged as a fingerprint.
# CRM_LOG=off
# AGENT_LOG=off
