# ---------------------------------------------------------------------------
# Residential Property Acquisition CRM - Jacksonville / Duval County, FL
#
# Every variable here is optional. With none of them set the application still
# runs: it reads the bundled sample extract of real Duval parcels, labels itself
# SAMPLE everywhere, and tells you plainly that no CRM store is attached. That
# is the state a fresh `git clone && pnpm install && pnpm dev` lands in, and it
# is deliberate - nothing about the map, the criteria, the scoring or the search
# needs a credential.
#
# Copy to .env.local for development. On Vercel, set them in
# Project Settings -> Environment Variables and redeploy.
# ---------------------------------------------------------------------------


# --- Property data ---------------------------------------------------------
#
# The output of the continuous Duval County Oracle pipeline, published to IPFS
# under a mutable IPNS name that moves with each new root. Pointing at it turns
# the bundled 75,988 parcel sample into the full published 404,023 parcel county
# table with no code change.
#
# Published by: https://github.com/prismteam-ai/oracle-property-intelligence-platform-pipeline-duval-fl
#
# There are TWO spellings of each, and the difference matters.
#
# NEXT_PUBLIC_* is read by the BROWSER, which is where parcel queries actually
# run: DuckDB-WASM in the tab range reads the parquet straight off the gateway.
# These are inlined into the bundle at build time, so changing one needs a new
# deployment rather than a restart. They are public, content-addressed URLs and
# nothing about them is secret.
#
# NEXT_PUBLIC_PROPERTY_DATA_URL=https://ipfs.filebase.io/ipns/k51qzi5uqu5djeq93ll0n7gsrzwfry2jmxb3xa66tcthufpjxv0c3odj1hpq4r
# NEXT_PUBLIC_RUN_HISTORY_URL=https://ipfs.filebase.io/ipfs/bafybeif2bwakcxmc3p2rkczkqvuecin6657oihsdm5mba5lktajoazemdm

# The unprefixed pair is read by NODE: the scheduled matcher in GitHub Actions,
# and the API routes that report pipeline freshness. The matcher uses native
# DuckDB, which range reads the same artifact more efficiently than the WASM
# build can. Set both pairs to the same URLs.
#
# PROPERTY_DATA_URL=https://ipfs.filebase.io/ipns/k51qzi5uqu5djeq93ll0n7gsrzwfry2jmxb3xa66tcthufpjxv0c3odj1hpq4r
# RUN_HISTORY_URL=https://ipfs.filebase.io/ipfs/bafybeif2bwakcxmc3p2rkczkqvuecin6657oihsdm5mba5lktajoazemdm

# Which query engine Node should use. Left unset it prefers native and falls
# back to WASM when the addon will not load. `native` on a workflow runner,
# where the 70 MB shared library is not a problem.
# PROPERTY_ENGINE=native

# Pull a remote artifact down once instead of range reading it.
#
# Range reading is normally why the native engine is worth preferring: one query
# costs a few hundred kilobytes against a 50 MB file. But it turns a query into
# hundreds of small HTTP requests, and the public IPFS gateway rate limits and
# then times out under that - a scheduled pass answered "Timeout was reached"
# for every saved search after thirteen minutes of it. One 50 MB transfer takes
# about a minute and every query afterwards is local.
#
# Defaults to on when CI=true and off otherwise, which is the right way round:
# a workflow runner outlives the query, a developer's single query does not.
# PROPERTY_FETCH_WHOLE=1

# County identity, used for labels only.
# NEXT_PUBLIC_COUNTY_NAME=Duval
# NEXT_PUBLIC_STATE_CODE=FL

# Where the map opens. Downtown Jacksonville by default.
# NEXT_PUBLIC_MAP_LAT=30.3322
# NEXT_PUBLIC_MAP_LNG=-81.6557
# NEXT_PUBLIC_MAP_ZOOM=10.5


# --- CRM store -------------------------------------------------------------
#
# Holds only what a team creates: saved criteria, alerts, opportunities,
# outreach, tasks, court records. Thousands of rows, not hundreds of thousands.
# The 404,023 parcels are NOT copied here - they stay in the published parquet
# and are read by DuckDB-WASM in the browser.
#
# Three backends, chosen in this order. The zero-infrastructure one is the
# default, on purpose: the story asks the CRM to run "without requiring Oracle
# to carry ongoing hosted-database cost beyond the existing Duval pipeline +
# DuckDB / Elephant IPFS pattern", and a hosted database is a hosted database
# whether or not its free tier happens to cost nothing today.


# 1. GIT DOCUMENTS (default). JSON aggregates committed to a branch, which is
#    the same mechanism the Duval pipeline uses to commit its run history. A
#    repository is not a database: nothing is provisioned, nothing runs between
#    requests, and there is no bill.
#
#    The document key carries the invariants a schema would spend unique indexes
#    on - opportunities/<propertyId>, alerts/<run>__<search>__<parcel> - so two
#    writers cannot collide on the same document by accident.
#
# CRM_STORE_REPO=owner/repo
# CRM_STORE_BRANCH=crm-state
# CRM_STORE_ROOT=crm

#    Writes need a FINE-GRAINED token, scoped to that one repository, with
#    Contents: read and write. Nothing else. Create one at
#    https://github.com/settings/personal-access-tokens/new
#
#    Without it the store is read-only: the CRM shows state and says plainly
#    that it cannot change it, rather than failing on the first click. Do not
#    use a classic token here - `repo` scope reaches every repository you own,
#    and none of that is needed.
#
# CRM_STORE_TOKEN=github_pat_...

#    Who the commits are attributed to, so the history says what wrote each
#    change.
# CRM_STORE_AUTHOR_NAME=duval-acquisitions-crm
# CRM_STORE_AUTHOR_EMAIL=crm@example.invalid


# 2. POSTGRES (opt-in). For a team that already runs one and wants real
#    concurrency. One table, created on first use, no migration step. Neon's
#    free tier works and needs no card.
#
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require


# 3. IN PROCESS (fallback). With neither of the above configured the CRM works
#    immediately and completely - saved searches, alerts, opportunities, the
#    whole loop - and loses everything on restart. The app says so on screen
#    rather than leaving it to be discovered. It is the right default for trying
#    the thing out and the wrong one for running a business on.


# --- Scheduled matcher -----------------------------------------------------
#
# /api/matcher/run accepts already-evaluated matches and decides what to alert
# on. It is guarded by a shared secret rather than a session; with this unset
# the endpoint is open, which is correct for a public demo and is stated here
# rather than left as a surprise.
#
# The SCHEDULED pass does not use it: .github/workflows/matcher.yml runs the
# matcher itself on the runner and writes to the store directly, so it needs the
# store's own configuration as repository secrets and variables rather than a
# runtime token.
#
# MATCHER_TOKEN=

# Where mocked alert notifications are addressed. Both default to reserved,
# unroutable values (RFC 2606 .invalid, and a 555 number) because nothing here
# should ever reach a real inbox or handset.
# ALERT_EMAIL=acquisitions@example.invalid
# ALERT_SMS=+1-904-555-0100


# --- Mocked outreach -------------------------------------------------------
#
# Whose name and callback number appear in the simulated owner letters.
# OUTREACH_SENDER_NAME=Dana Whitfield, Riverbend Acquisitions
# OUTREACH_SENDER_PHONE=(904) 555-0142


# --- Model provider --------------------------------------------------------
#
# THIS DEPLOYMENT SETS NONE OF THESE, ON PURPOSE, and after the agent moved into
# the browser they would have no effect on it anyway.
#
# The agent's tools have to reach the parcel data, and the parcel data is read
# by DuckDB-WASM in the visitor's tab, so the tool loop runs there. The key is
# stored in that browser and has never been sent to this server. /api/agent is
# now a capability probe only.
#
# lib/oracle/agent/providers.ts is the source of truth for which providers and
# models are supported. Not every provider allows a browser to call it: Google
# AI Studio does, Anthropic needs an explicit opt-in, and some block browser
# origins outright. The settings page says which.

# Optional. One of: google, groq, cerebras, huggingface, vercel-ai-gateway,
# anthropic, bedrock. Naming a provider without giving it a key is treated as a
# misconfiguration rather than quietly falling through to another provider.
# AGENT_PROVIDER=google
# AGENT_MODEL=gemini-3.7-flash

# GOOGLE_GENERATIVE_AI_API_KEY=      # https://aistudio.google.com/apikey
# GROQ_API_KEY=                      # https://console.groq.com/keys
# CEREBRAS_API_KEY=                  # https://cloud.cerebras.ai
# HF_TOKEN=                          # https://huggingface.co/settings/tokens
# AI_GATEWAY_API_KEY=                # Vercel dashboard -> AI Gateway
# ANTHROPIC_API_KEY=                 # https://console.anthropic.com/settings/keys
# AWS_BEARER_TOKEN_BEDROCK=


# --- Abuse controls --------------------------------------------------------
#
# Per client address, counted in process. Several instances may run, so the real
# cap is per instance rather than global.
# AGENT_RATE_LIMIT=15
# AGENT_RATE_WINDOW_MS=600000


# --- Logging ---------------------------------------------------------------
#
# One JSON line per event on stdout. Set to "off" to silence.
# Log lines never contain key material: every message on the agent path goes
# through redaction first, and a key is only ever logged as a fingerprint.
# CRM_LOG=off
# AGENT_LOG=off
