# ---------------------------------------------------------------------------
# Residential Property Acquisition CRM - Jacksonville / Duval County, FL
#
# Every variable here is optional. With none of them set the application still
# runs: it reads the bundled sample extract of real Duval parcels, labels itself
# SAMPLE everywhere, and tells you plainly that no CRM store is attached. That
# is the state a fresh `git clone && pnpm install && pnpm dev` lands in, and it
# is deliberate - nothing about the map, the criteria, the scoring or the search
# needs a credential.
#
# Copy to .env.local for development. On Vercel, set them in
# Project Settings -> Environment Variables and redeploy.
# ---------------------------------------------------------------------------


# --- Property data ---------------------------------------------------------
#
# The output of the continuous Duval County Oracle pipeline, published to IPFS
# under a mutable IPNS name that moves with each new root. Pointing at it turns
# the bundled 75,988 parcel sample into the full published 404,023 parcel county
# table with no code change.
#
# Published by: https://github.com/prismteam-ai/oracle-property-intelligence-platform-pipeline-duval-fl
#
# There are TWO spellings of each, and the difference matters.
#
# NEXT_PUBLIC_* is read by the BROWSER, which is where parcel queries actually
# run: DuckDB-WASM in the tab range reads the parquet straight off the gateway.
# These are inlined into the bundle at build time, so changing one needs a new
# deployment rather than a restart. They are public, content-addressed URLs and
# nothing about them is secret.
#
# NEXT_PUBLIC_PROPERTY_DATA_URL=https://ipfs.filebase.io/ipns/k51qzi5uqu5djeq93ll0n7gsrzwfry2jmxb3xa66tcthufpjxv0c3odj1hpq4r
# NEXT_PUBLIC_RUN_HISTORY_URL=https://ipfs.filebase.io/ipns/k51qzi5uqu5dl3zmapadjh90auy4k6gtr6w52zg6ozeu64kzbiwwgw8k9ef6ny

# The unprefixed pair is read by NODE: the scheduled matcher in GitHub Actions,
# and the API routes that report pipeline freshness. The matcher uses native
# DuckDB, which range reads the same artifact more efficiently than the WASM
# build can. Set both pairs to the same URLs.
#
# PROPERTY_DATA_URL=https://ipfs.filebase.io/ipns/k51qzi5uqu5djeq93ll0n7gsrzwfry2jmxb3xa66tcthufpjxv0c3odj1hpq4r
# RUN_HISTORY_URL=https://ipfs.filebase.io/ipns/k51qzi5uqu5dl3zmapadjh90auy4k6gtr6w52zg6ozeu64kzbiwwgw8k9ef6ny

# QUERY_TABLE_URL and NEXT_PUBLIC_QUERY_TABLE_URL are accepted as fallbacks for
# the pair above, in that order, because that is what the pipeline repository
# calls the same artifact. They exist so a value copied from there works; prefer
# PROPERTY_DATA_URL, which is what the rest of this file and the UI say.
# QUERY_TABLE_URL=
# NEXT_PUBLIC_QUERY_TABLE_URL=

# Both run-history URLs above are the pipeline's `oracle-run-history-duval` IPNS
# name, not a CID. That distinction is the whole point of the /pipeline page: a
# CID is immutable, so pointing at one freezes the history at however many runs
# it held when it was pinned, and the page then shows a number that stops moving
# while the pipeline keeps publishing. The name re-points on every publish.

# Which query engine Node should use. Left unset it prefers native and falls
# back to WASM when the addon will not load. `native` on a workflow runner,
# where the 70 MB shared library is not a problem.
# PROPERTY_ENGINE=native

# Pull a remote artifact down once instead of range reading it.
#
# Range reading is normally why the native engine is worth preferring: one query
# costs a few hundred kilobytes against a 50 MB file. But it turns a query into
# hundreds of small HTTP requests, and the public IPFS gateway rate limits and
# then times out under that - a scheduled pass answered "Timeout was reached"
# for every saved search after thirteen minutes of it. One 50 MB transfer takes
# about a minute and every query afterwards is local.
#
# Defaults to on when CI=true and off otherwise, which is the right way round:
# a workflow runner outlives the query, a developer's single query does not.
# PROPERTY_FETCH_WHOLE=1

# Where else the tab may look for the same artifact.
#
# Every read in the browser goes to ONE gateway, and a public IPFS gateway is
# allowed to be slow or down. Depending on a single one with no fallback meant a
# bad minute at Filebase looked exactly like a broken deployment: the page hung
# on "attaching" with nothing on screen to say why. The app now probes and fails
# over instead.
#
# The gateway named in NEXT_PUBLIC_PROPERTY_DATA_URL always leads; these are
# tried after it, each applied to the content id that URL already names, so the
# artifact addressed is identical on every one of them. Comma or whitespace
# separated. Two shapes are understood, because the two public gateway
# conventions are not interchangeable: a plain origin is a PATH rewrite
# (https://ipfs.io/ipns/<name>), and a {id}/{ns} template is a SUBDOMAIN rewrite
# (https://<name>.ipns.dweb.link/). A template is dropped rather than mangled
# when the content id is not a valid DNS label, so a CIDv0 Qm... simply yields
# one fewer candidate.
#
# A gateway here must answer a CORS PREFLIGHT, not merely a request. dweb.link's
# path form answers the preflight with a 301, which a browser treats as a hard
# failure - it never sends the ranged request that follows. It was half the
# default list and could not have worked in any browser. Its subdomain form does
# work, so the default addresses it that way: {id} is the content id and {ns} is
# ipns or ipfs. Verified 2026-08-22 by cross-origin ranged GET, not by HEAD.
#
# Leave this UNSET unless you have verified your replacements the same way. The
# built-in default is correct; an override here silently replaces it.
# NEXT_PUBLIC_IPFS_GATEWAYS=https://ipfs.io,https://{id}.{ns}.dweb.link,https://ipfs.filebase.io

# How long one gateway gets to attach the parquet before the next is tried.
# NEXT_PUBLIC_ATTACH_TIMEOUT_MS=45000

# How long one gateway gets to answer the probe before it is written off.
#
# The probe is a one-byte ranged GET - `Range: bytes=0-0` - and not a HEAD. That
# is deliberate: it is the exact request the engine will make, CORS preflight
# included, and the cheaper HEAD is what let a gateway that could never have
# served a browser keep passing.
#
# The order gateways are tried in is fixed - the one in the data URL, then these
# in the order they are listed. This does not reorder them; it is the cheap gate
# in front of each one in turn. A gateway that will not answer one byte in eight
# seconds is not going to range read a 50 MB artifact either, so it is skipped
# for the price of one request instead of the whole attach deadline.
# NEXT_PUBLIC_GATEWAY_PROBE_TIMEOUT_MS=8000

# The smallest object this deployment will accept as the query table.
#
# A gateway is allowed to answer a range request with 206 and hand back an error
# page - gw3.io reports a 965 byte total for a 50 MB parquet - and believing it
# costs a whole attach deadline and then a baffling DuckDB parse error. Anything
# claiming less than this is refused rather than believed.
# NEXT_PUBLIC_ARTIFACT_MIN_BYTES=1048576

# How many times ONE gateway is tried before moving on, within a single pass,
# and how long the first retry waits (doubling per attempt, capped at 8x).
#
# Only a fast failure is retried - a 502, a rate limit, a connection reset. A
# gateway that consumed its whole deadline saying nothing has had its chance.
# NEXT_PUBLIC_GATEWAY_ATTEMPTS=2
# NEXT_PUBLIC_GATEWAY_RETRY_BACKOFF_MS=750

# How many times the WHOLE candidate list is swept before giving up.
#
# Failover alone treats a bad thirty seconds as permanent: the first gateway is
# written off, the list runs out, and the app gives up while the gateway that
# stumbled is already answering again. A second sweep costs nothing when the
# first one works. This browser's cached copy is tried after the first sweep.
# NEXT_PUBLIC_GATEWAY_PASSES=2

# The wall-clock bound on the whole attach, across every gateway, pass and
# attempt. Without it, passes x candidates x attempts x two deadlines multiplies
# out to a quarter of an hour, which is not a wait but an abandonment.
# NEXT_PUBLIC_ATTACH_BUDGET_MS=120000

# Whether a successful load tops this browser's cached copy up in the background.
#
# On by default, and it is what makes the cache a real fallback rather than a
# decoration: a range read deliberately never touches most of the file, so
# without one deliberate whole-object fetch there is nothing on disk to fall
# back to when every gateway is down. It costs the visitor one transfer, once
# per publish, on idle after the page is already usable. Set to 0 to turn it off.
#
# Entries are keyed on the CONTENT ADDRESS, not the gateway URL, so a copy taken
# from one gateway is found when another is configured. Nothing evicts: at most
# one entry per content address, overwritten in place on a same-address publish.
# NEXT_PUBLIC_ARTIFACT_PRECACHE=1

# Refuse to cache an artifact larger than this. 128 MB by default.
# NEXT_PUBLIC_ARTIFACT_CACHE_MAX_BYTES=134217728

# County identity, used for labels only.
# NEXT_PUBLIC_COUNTY_NAME=Duval
# NEXT_PUBLIC_STATE_CODE=FL

# Where the map opens. Downtown Jacksonville by default.
# NEXT_PUBLIC_MAP_LAT=30.3322
# NEXT_PUBLIC_MAP_LNG=-81.6557
# NEXT_PUBLIC_MAP_ZOOM=10.5

# The opening rectangle, "west,south,east,north" in degrees. Duval County by
# default. A malformed value falls back to that default rather than opening the
# map on the ocean.
# NEXT_PUBLIC_MAP_BOUNDS=-81.76,30.15,-81.36,30.47


# --- CRM store -------------------------------------------------------------
#
# Holds only what a team creates: saved criteria, alerts, opportunities,
# outreach, tasks, court records. Thousands of rows, not hundreds of thousands.
# The 404,023 parcels are NOT copied here - they stay in the published parquet
# and are read by DuckDB-WASM in the browser.
#
# Three backends, chosen in this order. The zero-infrastructure one is the
# default, on purpose: the story asks the CRM to run "without requiring Oracle
# to carry ongoing hosted-database cost beyond the existing Duval pipeline +
# DuckDB / Elephant IPFS pattern", and a hosted database is a hosted database
# whether or not its free tier happens to cost nothing today.


# 1. GIT DOCUMENTS (default). JSON aggregates committed to a branch, which is
#    the same mechanism the Duval pipeline uses to commit its run history. A
#    repository is not a database: nothing is provisioned, nothing runs between
#    requests, and there is no bill.
#
#    The document key carries the invariants a schema would spend unique indexes
#    on - opportunities/<propertyId>, alerts/<run>__<search>__<parcel> - so two
#    writers cannot collide on the same document by accident.
#
# CRM_STORE_REPO=owner/repo
# CRM_STORE_BRANCH=crm-state
# CRM_STORE_ROOT=crm

#    Writes need a FINE-GRAINED token, scoped to that one repository, with
#    Contents: read and write. Nothing else. Create one at
#    https://github.com/settings/personal-access-tokens/new
#
#    Without it the store is read-only: the CRM shows state and says plainly
#    that it cannot change it, rather than failing on the first click. Do not
#    use a classic token here - `repo` scope reaches every repository you own,
#    and none of that is needed.
#
# CRM_STORE_TOKEN=github_pat_...

#    Who the commits are attributed to, so the history says what wrote each
#    change.
# CRM_STORE_AUTHOR_NAME=duval-acquisitions-crm
# CRM_STORE_AUTHOR_EMAIL=crm@example.invalid


# 2. POSTGRES (opt-in). For a team that already runs one and wants real
#    concurrency. One table, created on first use, no migration step. Neon's
#    free tier works and needs no card.
#
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
#    POSTGRES_URL is read as a fallback under the same rules, because that is
#    the name a Vercel Postgres integration injects.
# POSTGRES_URL=


# 3. IN PROCESS (fallback). With neither of the above configured the CRM works
#    immediately and completely - saved searches, alerts, opportunities, the
#    whole loop - and loses everything on restart. The app says so on screen
#    rather than leaving it to be discovered. It is the right default for trying
#    the thing out and the wrong one for running a business on.


# --- Scheduled matcher -----------------------------------------------------
#
# /api/matcher/run accepts already-evaluated matches and decides what to alert
# on. It is guarded by a shared secret rather than a session; with this unset
# the endpoint is open, which is correct for a public demo and is stated here
# rather than left as a surprise.
#
# The SCHEDULED pass does not use it: .github/workflows/matcher.yml runs the
# matcher itself on the runner and writes to the store directly, so it needs the
# store's own configuration as repository secrets and variables rather than a
# runtime token.
#
# MATCHER_TOKEN=

# Where mocked alert notifications are addressed. Both default to reserved,
# unroutable values (RFC 2606 .invalid, and a 555 number) because nothing here
# should ever reach a real inbox or handset.
# ALERT_EMAIL=acquisitions@example.invalid
# ALERT_SMS=+1-904-555-0100


# --- Mocked outreach -------------------------------------------------------
#
# Whose name and callback number appear in the simulated owner letters.
# OUTREACH_SENDER_NAME=Dana Whitfield, Riverbend Acquisitions
# OUTREACH_SENDER_PHONE=(904) 555-0142


# --- Model provider --------------------------------------------------------
#
# Set a key here and the Ask page offers that provider's models in a dropdown
# and answers on this deployment's account. Set nothing and the page says so,
# and every other page carries on working - nothing else here needs a model.
#
# There is no per-visitor key. Asking the person evaluating a CRM to mint an API
# key before it will answer a question is a failure at the question.
#
# HOW A SERVER KEY REACHES A LOOP THAT RUNS IN THE BROWSER. It does not. The
# agent's tools query the parcel data and that data is read by DuckDB-WASM in
# the tab, so the loop runs there. When it uses one of this deployment's models
# the model call goes to /api/llm/<provider>, which forwards it upstream with
# the key attached. The key stays on the server; the tools stay in the tab.
#
# That route is not an open proxy: the provider must be known and configured
# here, the model must be one lib/oracle/agent/providers.ts lists, and every
# caller is rate limited (see below). It still means a public runtime answering
# on your account, which is a bill a stranger can run up - the rate limiter
# raises the effort, it does not remove the risk. Configure a key only on a
# deployment you are willing to have used.
#
# Bedrock is the one provider this cannot forward: it signs the whole request
# with SigV4 rather than carrying a header token. It stays in the registry so a
# clone knows what it would have to add, and is never offered.

# Which provider leads the dropdown, and which of its models is preselected.
# Naming a provider without giving it a key is treated as a misconfiguration
# rather than quietly falling through to another provider.
# AGENT_PROVIDER=openai
# AGENT_MODEL=gpt-5-mini

# OPENAI_API_KEY=                    # https://platform.openai.com/api-keys
# OPENROUTER_API_KEY=                # https://openrouter.ai/settings/keys
# GOOGLE_GENERATIVE_AI_API_KEY=      # https://aistudio.google.com/apikey
# GROQ_API_KEY=                      # https://console.groq.com/keys
# CEREBRAS_API_KEY=                  # https://cloud.cerebras.ai
# HF_TOKEN=                          # https://huggingface.co/settings/tokens
# AI_GATEWAY_API_KEY=                # Vercel dashboard -> AI Gateway
# ANTHROPIC_API_KEY=                 # https://console.anthropic.com/settings/keys
# AWS_BEARER_TOKEN_BEDROCK=          # not forwardable, see above


# --- Write access ----------------------------------------------------------
#
# This runtime is public and has no login, because a reviewer has to use every
# feature from a cold browser. It also holds a write token for the CRM store, so
# it writes on the owner's credential for whoever shows up. None of these
# variables changes that while the runtime stays open; they bound it.
#
# Freeze every write from a dashboard, without a redeploy, without taking search
# offline. The UI already renders the refusal.
# CRM_READ_ONLY=1

# Require a token on every mutation. Unset by default, which is what keeps the
# public demo usable with no login. Set it and the runtime is read-only to
# strangers and writable by whoever holds this.
# CRM_WRITE_TOKEN=

# Extra hosts allowed to write, beyond this deployment's own. Mutations must
# carry an Origin naming an allowed host, which is real CSRF protection and
# turns a bare curl into a 403. It does not stop a caller who sets the header by
# hand; see lib/api-auth.ts, which says so rather than implying otherwise.
# CRM_ALLOWED_ORIGINS=https://example.test

# Mutations per address per window, and a tighter pair for the expensive ones
# (a matcher pass, an outreach campaign, a simulation).
# CRM_WRITE_RATE_LIMIT=120
# CRM_WRITE_RATE_WINDOW_MS=600000
# CRM_HEAVY_WRITE_RATE_LIMIT=20
# CRM_HEAVY_WRITE_RATE_WINDOW_MS=600000


# --- Abuse controls --------------------------------------------------------
#
# Per client address, counted in process. Several instances may run, so the real
# cap is per instance per window rather than global. This is what stands between
# a configured server key and a stranger spending it, so lower it rather than
# raising it if the deployment is public and the key is yours.
#
# The unit counted is the MODEL CALL, because that is what costs tokens and
# function seconds, and because a client-supplied "this is a new question"
# marker on a public endpoint is a field an abuser sets on every request.
#
# Two ways to say the same thing. AGENT_QUESTION_BUDGET is the friendly one:
# full-depth questions per address per window, multiplied out by the agent's
# step ceiling (12 steps a question), so 12 questions is 144 model calls.
# AGENT_RATE_LIMIT is the raw call ceiling and keeps the meaning it has always
# had, so an operator who set it is not silently given a different cap; when it
# is set, AGENT_QUESTION_BUDGET is ignored.
#
# The values below are the effective defaults, not suggestions: unset, this
# deployment allows 12 full-depth questions per address per ten minutes, which
# is 144 model calls. It replaced a flat 15 CALLS that was written down as
# "fifteen questions" and actually bought about 1.25 of them, which is a
# reviewer being refused halfway through their second question.
# AGENT_QUESTION_BUDGET=12
# AGENT_RATE_LIMIT=144
# AGENT_RATE_WINDOW_MS=600000


# --- Logging ---------------------------------------------------------------
#
# One JSON line per event on stdout. Set to "off" to silence.
# Log lines never contain key material: every message on the agent path goes
# through redaction first, and a key is only ever logged as a fingerprint.
# CRM_LOG=off
# AGENT_LOG=off
